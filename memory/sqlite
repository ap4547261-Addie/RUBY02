# memory/sqlite.py
import sqlite3
from datetime import datetime

DB_PATH = "ruby_memory.db"

def init_db():
    """Initialize the database with enhanced schema"""
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()
    
    # Messages table
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS messages (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            role TEXT NOT NULL,
            content TEXT NOT NULL,
            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        )
    """)
    
    # Facts/memories table
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS facts (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            content TEXT UNIQUE NOT NULL,
            importance INTEGER DEFAULT 1,
            category TEXT DEFAULT 'general',
            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
            synced INTEGER DEFAULT 0
        )
    """)
    
    # Stats table
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS stats (
            key TEXT PRIMARY KEY,
            value INTEGER DEFAULT 0,
            updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        )
    """)
    
    # Insert default stats
    cursor.execute("""
        INSERT OR IGNORE INTO stats (key, value) 
        VALUES ('interaction_count', 0)
    """)
    cursor.execute("""
        INSERT OR IGNORE INTO stats (key, value) 
        VALUES ('total_facts', 0)
    """)
    
    # Create indexes
    cursor.execute("CREATE INDEX IF NOT EXISTS idx_messages_created ON messages(created_at DESC)")
    cursor.execute("CREATE INDEX IF NOT EXISTS idx_facts_importance ON facts(importance DESC)")
    
    conn.commit()
    conn.close()

def save_message(role, content):
    """Save a message to the database"""
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()
    cursor.execute("""
        INSERT INTO messages (role, content, created_at)
        VALUES (?, ?, CURRENT_TIMESTAMP)
    """, (role, content))
    
    # Update interaction count
    cursor.execute("""
        UPDATE stats SET value = value + 1, updated_at = CURRENT_TIMESTAMP
        WHERE key = 'interaction_count'
    """)
    
    conn.commit()
    conn.close()

def get_recent_messages(limit=20):
    """Get recent messages from the database"""
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()
    cursor.execute("""
        SELECT role, content FROM messages 
        ORDER BY id DESC LIMIT ?
    """, (limit,))
    rows = cursor.fetchall()
    conn.close()
    
    # Return in chronological order (oldest first)
    messages = [{"role": row[0], "content": row[1]} for row in reversed(rows)]
    return messages

def save_fact(content, importance=1, category='general'):
    """Save a fact/memory to the database"""
    try:
        conn = sqlite3.connect(DB_PATH)
        cursor = conn.cursor()
        cursor.execute("""
            INSERT OR IGNORE INTO facts (content, importance, category, created_at)
            VALUES (?, ?, ?, CURRENT_TIMESTAMP)
        """, (content, importance, category))
        
        # Update total facts count
        cursor.execute("""
            UPDATE stats SET value = value + 1, updated_at = CURRENT_TIMESTAMP
            WHERE key = 'total_facts'
        """)
        
        conn.commit()
        conn.close()
        print(f"Fact saved: {content[:50]}...")
    except Exception as e:
        print(f"Save fact error: {e}")

def get_all_memories(limit=10):
    """Get all memories from the database"""
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()
    cursor.execute("""
        SELECT content FROM facts 
        ORDER BY importance DESC, created_at DESC 
        LIMIT ?
    """, (limit,))
    rows = cursor.fetchall()
    conn.close()
    return [row[0] for row in rows]

def get_facts_by_category(category, limit=10):
    """Get facts by category"""
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()
    cursor.execute("""
        SELECT content FROM facts 
        WHERE category = ?
        ORDER BY importance DESC, created_at DESC
        LIMIT ?
    """, (category, limit))
    rows = cursor.fetchall()
    conn.close()
    return [row[0] for row in rows]

def get_important_facts(limit=10):
    """Get important facts"""
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()
    cursor.execute("""
        SELECT content FROM facts 
        WHERE importance >= 3
        ORDER BY importance DESC, created_at DESC
        LIMIT ?
    """, (limit,))
    rows = cursor.fetchall()
    conn.close()
    return [row[0] for row in rows]

def mark_fact_important(content):
    """Mark a fact as important"""
    try:
        conn = sqlite3.connect(DB_PATH)
        cursor = conn.cursor()
        cursor.execute("""
            UPDATE facts SET importance = 3
            WHERE content = ?
        """, (content,))
        conn.commit()
        conn.close()
    except Exception as e:
        print(f"Mark important error: {e}")

def cleanup_old_facts(days=30):
    """Clean up old low-importance facts"""
    try:
        conn = sqlite3.connect(DB_PATH)
        cursor = conn.cursor()
        cursor.execute("""
            DELETE FROM facts 
            WHERE created_at < datetime('now', ?) 
            AND importance < 2
        """, (f'-{days} days',))
        deleted = cursor.rowcount
        conn.commit()
        conn.close()
        print(f"Cleaned up {deleted} old facts")
    except Exception as e:
        print(f"Cleanup error: {e}")

def get_stats():
    """Get database stats"""
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()
    
    stats = {}
    cursor.execute("SELECT key, value FROM stats")
    for key, value in cursor.fetchall():
        stats[key] = value
    
    cursor.execute("SELECT COUNT(*) FROM messages")
    stats['total_messages'] = cursor.fetchone()[0]
    
    cursor.execute("SELECT COUNT(*) FROM facts")
    stats['total_facts'] = cursor.fetchone()[0]
    
    cursor.execute("SELECT COUNT(*) FROM facts WHERE importance >= 3")
    stats['important_facts'] = cursor.fetchone()[0]
    
    conn.close()
    return stats
