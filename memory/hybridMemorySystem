    def get_important_memories(self, limit: int = None) -> list:
        """Get most important memories - NO LIMIT"""
        try:
            conn = sqlite3.connect(self.sqlite_path)
            cursor = conn.cursor()
            cursor.execute("""
                SELECT fact, created_at 
                FROM memories 
                WHERE importance >= 3
                ORDER BY importance DESC, created_at DESC
            """)
            rows = cursor.fetchall()
            conn.close()
            return [row[0] for row in rows]
        except Exception as e:
            print(f"Important memories error: {e}")
            return []

    def mark_memory_important(self, fact: str):
        """Mark a memory as important"""
        try:
            conn = sqlite3.connect(self.sqlite_path)
            cursor = conn.cursor()
            cursor.execute("""
                UPDATE memories 
                SET importance = 3 
                WHERE fact = ?
            """, (fact,))
            conn.commit()
            conn.close()
            print(f"Memory marked as important: {fact[:50]}...")
        except Exception as e:
            print(f"Mark important error: {e}")

    def cleanup_old_memories(self, days: int = 30):
        """Clean up old low-importance memories"""
        try:
            conn = sqlite3.connect(self.sqlite_path)
            cursor = conn.cursor()
            cursor.execute("""
                DELETE FROM memories 
                WHERE created_at < datetime('now', ?) 
                AND importance < 2
            """, (f'-{days} days',))
            deleted = cursor.rowcount
            conn.commit()
            conn.close()
            print(f"Cleaned up {deleted} old memories")
        except Exception as e:
            print(f"Cleanup error: {e}")

    def reset_daily_counters(self):
        """Reset daily counters (called when Ruby wakes up)"""
        try:
            conn = sqlite3.connect(self.sqlite_path)
            cursor = conn.cursor()
            cursor.execute("""
                UPDATE stats SET value = '0', updated_at = CURRENT_TIMESTAMP
                WHERE key = 'conversations_today'
            """)
            cursor.execute("""
                UPDATE stats SET value = ?, updated_at = CURRENT_TIMESTAMP
                WHERE key = 'last_reset'
            """, (datetime.now().isoformat(),))
            conn.commit()
            conn.close()
            print("Daily counters reset")
        except Exception as e:
            print(f"Reset counters error: {e}")

    def get_stats(self) -> dict:
        """Get memory system stats"""
        conn = sqlite3.connect(self.sqlite_path)
        cursor = conn.cursor()
        
        stats = {}
        cursor.execute("SELECT key, value FROM stats")
        for key, value in cursor.fetchall():
            if key in ['interaction_count', 'total_memories', 'important_memories', 'conversations_today']:
                stats[key] = int(value) if value else 0
            else:
                stats[key] = value
        
        # Additional counts
        cursor.execute("SELECT COUNT(*) FROM memories")
        stats['total_memories_db'] = cursor.fetchone()[0]
        
        cursor.execute("SELECT COUNT(*) FROM memories WHERE importance >= 3")
        stats['important_memories_db'] = cursor.fetchone()[0]
        
        conn.close()
        return stats

    def process(self, response: str, user_message: str):
        """Process response for memory extraction"""
        if "[SAVE_MEMORY:" in response:
            try:
                start = response.index("[SAVE_MEMORY:") + len("[SAVE_MEMORY:")
                end = response.index("]", start)
                fact = response[start:end].strip()
                if fact:
                    # Extract importance if specified
                    importance = 1
                    category = 'general'
                    
                    # Check for importance marker
                    if "IMPORTANT:" in fact:
                        parts = fact.split("IMPORTANT:")
                        fact = parts[0].strip()
                        importance = 3
                        category = 'important'
                    elif "CATEGORY:" in fact:
                        parts = fact.split("CATEGORY:")
                        fact = parts[0].strip()
                        category = parts[1].split()[0].strip() if len(parts) > 1 else 'general'
                    
                    self.save_hybrid_memory(fact, importance, category)
            except Exception as e:
                print(f"Memory extraction error: {e}")
