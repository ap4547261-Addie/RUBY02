import os
import sqlite3
from google import genai

class HybridMemorySystem:
    def __init__(self, sqlite_path="ruby_memory.db"):
        self.sqlite_path = sqlite_path
        self._init_sqlite()

    def _init_sqlite(self):
        conn = sqlite3.connect(self.sqlite_path)
        cursor = conn.cursor()
        cursor.execute("""
            CREATE TABLE IF NOT EXISTS memories (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                fact TEXT UNIQUE
            )
        """)
        cursor.execute("""
            CREATE TABLE IF NOT EXISTS stats (
                key TEXT PRIMARY KEY,
                value TEXT
            )
        """)
        cursor.execute("INSERT OR IGNORE INTO stats (key, value) VALUES ('interaction_count', '0')")
        cursor.execute("INSERT OR IGNORE INTO stats (key, value) VALUES ('mood', 'neutral')")
        conn.commit()
        conn.close()

    def get_state(self) -> dict:
        conn = sqlite3.connect(self.sqlite_path)
        cursor = conn.cursor()
        cursor.execute("SELECT key, value FROM stats")
        rows = cursor.fetchall()
        conn.close()
        
        state = {}
        for key, value in rows:
            if key == 'interaction_count':
                state[key] = int(value) if value else 0
            else:
                state[key] = value
        return state

    def update_state(self, new_state: dict):
        conn = sqlite3.connect(self.sqlite_path)
        cursor = conn.cursor()
        for key, value in new_state.items():
            cursor.execute(
                "INSERT INTO stats (key, value) VALUES (?, ?) ON CONFLICT(key) DO UPDATE SET value = ?",
                (key, str(value), str(value))
            )
        conn.commit()
        conn.close()

    def save_hybrid_memory(self, fact: str):
        try:
            conn = sqlite3.connect(self.sqlite_path)
            cursor = conn.cursor()
            cursor.execute("INSERT OR IGNORE INTO memories (fact) VALUES (?)", (fact,))
            conn.commit()
            conn.close()
        except Exception as e:
            print(f"SQLite Save Error: {e}")

    def search_memories(self, query: str, limit=5) -> str:
        memories_found = []
        try:
            conn = sqlite3.connect(self.sqlite_path)
            cursor = conn.cursor()
            cursor.execute("SELECT fact FROM memories ORDER BY id DESC LIMIT ?", (limit,))
            rows = cursor.fetchall()
            conn.close()
            for row in rows:
                if row[0] not in memories_found:
                    memories_found.append(row[0])
        except Exception as e:
            print(f"SQLite Read Error: {e}")

        if not memories_found:
            return "No deep memories formed yet."
        return ", ".join(memories_found)

    def process(self, response: str, user_message: str):
        if "[SAVE_MEMORY:" in response:
            try:
                start = response.index("[SAVE_MEMORY:") + len("[SAVE_MEMORY:")
                end = response.index("]", start)
                fact = response[start:end].strip()
                if fact:
                    self.save_hybrid_memory(fact)
            except Exception as e:
                print(f"Memory extraction error: {e}")
